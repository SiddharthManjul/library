{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://library.ide/contracts/extraction.schema.json",
  "title": "Extraction output",
  "description": "The only thing a quarantine model may return: typed fields, closed lists, no free-form instructions. Anything that does not validate goes to the dead letter queue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entities",
    "facts"
  ],
  "properties": {
    "entities": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "kind",
          "name",
          "external_ids"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^e[0-9]{1,3}$"
          },
          "kind": {
            "enum": [
              "person",
              "repo",
              "pull_request",
              "issue",
              "channel",
              "project",
              "decision",
              "customer",
              "document"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "external_ids": {
            "type": "object",
            "maxProperties": 4,
            "propertyNames": {
              "enum": [
                "github",
                "slack",
                "google",
                "linear",
                "atlassian",
                "email",
                "notion",
                "hubspot"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "relation",
          "statement",
          "valid_from",
          "confidence_permille",
          "source_span"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^e[0-9]{1,3}$"
          },
          "relation": {
            "enum": [
              "authored",
              "assigned_to",
              "reviewed",
              "merged",
              "mentions",
              "decided",
              "blocks",
              "depends_on",
              "member_of",
              "owns",
              "opened",
              "closed",
              "status_changed",
              "commented_on",
              "approved"
            ]
          },
          "object": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^e[0-9]{1,3}$"
          },
          "statement": {
            "type": "string",
            "maxLength": 500
          },
          "valid_from": {
            "type": "integer",
            "minimum": 0,
            "description": "integer microseconds since the Unix epoch; floats never appear in hashed fields"
          },
          "confidence_permille": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "source_span": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
