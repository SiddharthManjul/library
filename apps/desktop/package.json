{
  "name": "library-desktop",
  "private": true,
  "version": "0.0.1",
  "description": "Library IDE desktop app",
  "author": {
    "name": "Library",
    "email": "hello@library.ide"
  },
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "package:linux": "pnpm build && pnpm package:node:linux && electron-builder --linux deb AppImage --publish never",
    "package:win": "pnpm build && pnpm package:node:win && electron-builder --win appx --publish never",
    "package:node:linux": "cargo build --release -p library-node --manifest-path ../../Cargo.toml",
    "package:node:win": "cargo build --release -p library-node --manifest-path ../../Cargo.toml",
    "package:dir": "pnpm build && pnpm package:node:linux && electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^27.0.0",
    "playwright-core": "1.65.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "^8.0.0",
    "vitest": "5.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dependencies": {},
  "homepage": "https://library.ide",
  "packageManager": "pnpm@12.23.0"
}
